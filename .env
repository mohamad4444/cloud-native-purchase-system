# ============================================
# Registry and Tag configuration
# ============================================
REGISTRY=localhost:5000
TAG=latest

# ============================================
# Frontend configuration
# ============================================
FRONTEND_PORT=80

# ============================================
# API Proxy configuration
# ============================================
API_PROXY_PORT=8280
#not used just for reference
API_PROXY_KEYCLOAK_URL=http://localhost:8280/auth

# ============================================
# Keycloak configuration
# ============================================
KC_DB=keycloak
KC_DB_URL=jdbc:postgresql://keycloak-db:5432/keycloak
#container name or site
KC_DB_HOST=keycloak-db 
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak_password

KC_PROXY_HEADERS=xforwarded
PROXY_ADDRESS_FORWARDING=true
#URL of api proxy
KEYCLOAK_FRONTEND_URL=http://localhost:8080/auth
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_BACKCHANNEL=false
KC_HTTP_RELATIVE_PATH=/auth
KC_PROXY=edge
KEYCLOAK_PORT=8080
# ============================================
# Postgres Databases
# ============================================
# Keycloak DB

POSTGRES_DB_KEYCLOAK=keycloak
POSTGRES_USER_KEYCLOAK=keycloak
POSTGRES_PASSWORD_KEYCLOAK=keycloak_password
KC_DB_PORT=5432

# Purchase DB
PURCHASE_DB_PORT=5433
POSTGRES_DB_PURCHASE=purchase_db
POSTGRES_USER_PURCHASE=purchase_user
POSTGRES_PASSWORD_PURCHASE=purchase_password

# Inventory DB
INVENTORY_DB_PORT=5434
POSTGRES_DB_INVENTORY=inventory_db
POSTGRES_USER_INVENTORY=inventory_user
POSTGRES_PASSWORD_INVENTORY=inventory_password

# ============================================
# Artemis configuration
# ============================================
ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=artemis_password
ANONYMOUS_LOGIN=false
ARTEMIS_CORE_PORT=61616
ARTEMIS_WEB_PORT=8161

# ============================================
# Monitoring stack
# ============================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ============================================
# Inventory Service
# ============================================
INVENTORY_SERVICE_PORT=8081

#application.properties
SPRING_PROFILES_ACTIVE_INVENTORY=dev
DATASOURCE_URL_INVENTORY=jdbc:postgresql://inventory-db:5432/inventory_db

# ============================================
# Purchase Service
# ============================================
PURCHASE_SERVICE_PORT=8082
DATASOURCE_HOST_PURCHASE=localhost
SPRING_PROFILES_ACTIVE_PURCHASE=dev
DATASOURCE_URL_PURCHASE=jdbc:postgresql://purchase-db:5432/purchase_db



# Common application.properties
ARTEMIS_BROKER_URL=tcp://artemis:61616
KEYCLOAK_ISSUER_URI=http://keycloak:8080/auth/realms/purchase-service-realm
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/auth/realms/purchase-service-realm/protocol/openid-connect/certs
SPRING_SECURITY_LOG_LEVEL=INFO
APP_QUEUE_NAME=my-queue


#Extra?
INVENTORY_QUEUE_NAME=inventory.events
PURCHASE_QUEUE_NAME=purchase.events
JMS_DESTINATION=purchase-queue
KC_DB=postgres
SPRING_PROFILES_ACTIVE_PROFILE=dev