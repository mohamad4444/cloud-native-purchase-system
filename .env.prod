# Frontend
FRONTEND_PORT=80

# Keycloak
KEYCLOAK_PORT=8080
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://keycloak-db:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=ChangeThisPass!
KC_HOSTNAME=auth.example.com
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeThisAdminPass!

# Keycloak DB
KEYCLOAK_DB_PORT=5432
POSTGRES_DB_KEYCLOAK=keycloak
POSTGRES_USER_KEYCLOAK=keycloak
POSTGRES_PASSWORD_KEYCLOAK=ChangeThisPass!

# Purchase DB
PURCHASE_DB_PORT=5432
POSTGRES_DB_PURCHASE=purchase
POSTGRES_USER_PURCHASE=purchase_user
POSTGRES_PASSWORD_PURCHASE=ChangeThisPass!

# Inventory DB
INVENTORY_DB_PORT=5432
POSTGRES_DB_INVENTORY=inventory
POSTGRES_USER_INVENTORY=inventory_user
POSTGRES_PASSWORD_INVENTORY=ChangeThisPass!

# Artemis
ARTEMIS_USER=admin
ARTEMIS_PASSWORD=ChangeThisPass!
ANONYMOUS_LOGIN=false
ARTEMIS_CORE_PORT=61616
ARTEMIS_WEB_PORT=8161

# Prometheus
