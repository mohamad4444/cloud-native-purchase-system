{{- $releaseValues := .Values | get .Release.Name dict | default dict -}}
{{- $globalConfig := .Values | get "globalConfig" dict | default dict -}}
{{- $globalBefore := .Values | get "globalBefore" dict | default dict -}}
{{- $globalAfter := .Values | get "globalAfter" dict | default dict -}}

{{- /* Start with empty dict (chart defaults already exist in .Values) */ -}}
{{- $merged := dict -}}

{{- /* Merge globalBefore: low-priority defaults */ -}}
{{- range $k, $v := $globalBefore -}}
  {{- $_ := set $merged $k $v -}}
{{- end -}}

{{- /* Merge releaseValues: medium-priority, overwrite globalBefore */ -}}
{{- range $k, $v := $releaseValues -}}
  {{- $_ := set $merged $k $v -}}
{{- end -}}

{{- /* Merge globalAfter: high-priority, overwrite everything */ -}}
{{- range $k, $v := $globalAfter -}}
  {{- $_ := set $merged $k $v -}}
{{- end -}}

{{- /* Add globalConfig as separate namespace */ -}}
{{- if $globalConfig }}
{{- $_ := set $merged "globalConfig" $globalConfig -}}
{{- end }}

{{- $merged | toYaml -}}
