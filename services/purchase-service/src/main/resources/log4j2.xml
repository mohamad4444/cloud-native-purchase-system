<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout>
                <pattern>%style{%d{HH:mm:ss.SSS}}{cyan} %highlight{%-5level} %style{[%t]}{magenta} %style{%logger{36}}{blue} - %msg%n%throwable</pattern>
            </PatternLayout>
        </Console>
    </Appenders>

    <Loggers>
        <!-- Log controller classes -->
        <Logger name="swtp.clouddemo.purchase.controller" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Log AOP aspect classes -->
        <Logger name="swtp.clouddemo.common.aop" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Disable everything else -->
        <Root level="off"/>
    </Loggers>
</Configuration>
