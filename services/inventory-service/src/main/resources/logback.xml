<?xml version="1.0" encoding="UTF-8"?>
<!-- returns a normal output not json-->
<configuration>

  <!-- Console appender with color support -->
  <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>
        %highlight(%d{HH:mm:ss.SSS}) %highlight(%-5level) [%thread] %cyan(%logger{36}) - %msg%n%ex
      </pattern>
    </encoder>
  </appender>

  <!-- Package-specific loggers -->
  <!-- <logger name="org.springframework.security" level="TRACE" additivity="false">
    <appender-ref ref="Console"/>
  </logger>

  <logger name="org.springframework.web" level="TRACE" additivity="false">
    <appender-ref ref="Console"/>
  </logger>

  <logger name="org.apache.http" level="DEBUG" additivity="false">
    <appender-ref ref="Console"/>
  </logger>

  <logger name="org.apache.http.wire" level="DEBUG" additivity="false">
    <appender-ref ref="Console"/>
  </logger>

  <logger name="org.springframework.security.oauth2" level="TRACE" additivity="false">
    <appender-ref ref="Console"/>
  </logger>

  <logger name="org.hibernate.orm.jdbc.bind" level="TRACE" additivity="false">
    <appender-ref ref="Console"/>
  </logger> -->

  <!-- Custom loggers from your app -->
  <logger name="swtp.clouddemo" level="DEBUG" additivity="false">
    <appender-ref ref="Console"/>
  </logger>

  <!-- Root logger logs warnings and above -->
  <root level="WARN">
    <appender-ref ref="Console"/>
  </root>

</configuration>
