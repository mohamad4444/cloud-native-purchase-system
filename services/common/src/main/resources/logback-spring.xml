<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ==============================
         Human-readable console appender for development
         ============================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!-- ==============================
         JSON console appender for staging
         ============================== -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"${APP_NAME}"}</customFields>
            <flattenThrowable>true</flattenThrowable>
            <includeCallerData>true</includeCallerData>

            <!-- Include specific MDC keys -->
            <includeMdcKeyName>method</includeMdcKeyName>
            <includeMdcKeyName>class</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>username</includeMdcKeyName>

            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>version</version>
                <message>message</message>
                <logger>logger</logger>
                <level>level</level>
                <thread>thread</thread>
                <stackTrace>stack_trace</stackTrace>
            </fieldNames>
        </encoder>
    </appender>

    <!-- ==============================
         Development / Local Profile
         ============================== -->
    <springProfile name="dev,local">
        <logger name="swtp.clouddemo" level="DEBUG" additivity="false">
            <appender-ref ref="JSON_CONSOLE" />
        </logger>
        <root level="WARN">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

    <!-- ==============================
         Staging Profile: JSON only
         ============================== -->
    <springProfile name="staging">

        <!-- Your application packages: DEBUG -->
        <logger name="swtp.clouddemo" level="DEBUG" additivity="false">
            <appender-ref ref="JSON_CONSOLE" />
        </logger>

        <!-- Spring / Hibernate / other libs: WARN -->
        <logger name="org.springframework" level="WARN" additivity="false">
            <appender-ref ref="JSON_CONSOLE" />
        </logger>
        <logger name="org.hibernate" level="WARN" additivity="false">
            <appender-ref ref="JSON_CONSOLE" />
        </logger>
        <logger name="org.apache" level="WARN" additivity="false">
            <appender-ref ref="JSON_CONSOLE" />
        </logger>

        <!-- Root: WARN for everything else -->
        <root level="WARN">
            <appender-ref ref="JSON_CONSOLE" />
        </root>
    </springProfile>

</configuration>
